<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.CollectMapper">

    <select id="selectAll" resultType="com.example.entity.Collect">
        select collect.*, goods.name as goodsName, goods.img goodsImg, goods.price as goodsPrice, user.name as userName from `collect`
        left join goods on collect.goods_id = goods.id
        left join user on collect.user_id = user.id
        <where>
            <if test="goodsName != null"> and goods.name like concat('%', #{goodsName}, '%')</if>
            <if test="userId != null"> and collect.user_id = #{userId}</if>
        </where>
        order by collect.id desc
    </select>

    <delete id="deleteById">
        delete from `collect`
        where id = #{id}
    </delete>
<!--修改：数据库使用下划线变量名，java采用小驼峰变量名，后续可考虑使用更明显的提示，如前缀S和前缀J，或者枚举-->
    <insert id="insert" parameterType="com.example.entity.Collect" useGeneratedKeys="true">
        insert into `collect`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="time != null">time,</if>
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="goodsId != null">#{goodsId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="time != null">#{time},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.Collect">
        update `collect`
        <set>
            <if test="id != null">
                id = #{id},
            </if>
            <if test="goodsId != null">
                goods_id = #{goodsId},
            </if>
            <if test="userId != null">
                user_id = #{userId},
            </if>
            <if test="time != null">
                time = #{time},
            </if>
        </set>
        where id = #{id}
        <!-- 补充：确保 id 不为空，避免全表更新 -->
        <if test="id == null">
            AND 1 = 0
        </if>
    </update>

</mapper>